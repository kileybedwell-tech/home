# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# From developer.ebay.com > Hi <you> > Application Keys.
# Pick the Production keyset (or Sandbox, with EBAY_ENVIRONMENT=sandbox).
EBAY_CLIENT_ID=YourApp-Name-PRD-abc123def-45678901
EBAY_CLIENT_SECRET=PRD-bc123def4567-89ab-cdef-0123-4567

# The RuName, NOT the https URL it points at. Same page, "User Tokens" tab,
# under "Get a Token from eBay via Your Application". Looks like a name, not a URL.
EBAY_REDIRECT_URI=Your_Name-YourApp-Name-abcdef

# production | sandbox
EBAY_ENVIRONMENT=production

# Which eBay site your listings live on: EBAY_US, EBAY_GB, EBAY_DE, EBAY_AU, ...
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CONTENT_LANGUAGE=en-US

# Optional: override where tokens are cached (default: ~/.config/ebay-connect/)
# EBAY_TOKEN_FILE=/secure/path/ebay-tokens.json

# Optional: skip the browser consent step entirely. Set this to the refresh
# token from an earlier `login` and any machine with these variables connects
# on its own - which is how an ephemeral container stays connected.
# EBAY_REFRESH_TOKEN=v^1.1#i^1#...
